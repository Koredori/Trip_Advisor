## This file is a TEMPLATE for local.properties
## Copy this file and rename it to: local.properties
## Then fill in the actual values below.
##
## ⚠️  DO NOT commit local.properties to version control.
##     It is already listed in .gitignore.

# Android SDK location (automatically set by Android Studio)
sdk.dir=C\:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk

# Google Maps API Key
# Get your key from: https://console.cloud.google.com/
# Enable "Maps SDK for Android" in the API Library.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
